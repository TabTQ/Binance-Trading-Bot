# Zerodha Trading Bot Configuration
# Copy this file to .env and fill in your values

# Zerodha Kite Connect API Credentials (REQUIRED)
# Get these from https://kite.trade/
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Access Token (REQUIRED - Generated daily via login)
# Use the provided login script to generate this token
# Token expires at end of each trading day
KITE_ACCESS_TOKEN=your_access_token_here

# Risk Management
RISK_PER_TRADE=0.02          # Risk 2% per trade
MAX_POSITION_SIZE=0.5        # Max 50% of capital per position
STOP_LOSS_PERCENT=0.01       # 1% stop loss (tighter for F&O)
TAKE_PROFIT_PERCENT=0.02     # 2% take profit
MAX_DAILY_LOSS=0.05          # Stop trading if 5% daily loss
MAX_DRAWDOWN=0.10            # Stop trading if 10% drawdown from peak

# Trading Mode
PAPER_TRADING=true           # Set to false for live trading
INITIAL_PAPER_BALANCE=100000 # Starting balance (1 Lakh INR) for paper trading

# F&O Contract Settings
DEFAULT_EXPIRY=current       # 'current' for current month, 'next' for next month
MAX_LOTS=10                  # Maximum number of lots to trade

# Lot Sizes (Update as per NSE - these change periodically)
NIFTY_LOT_SIZE=25            # Nifty50 lot size (check NSE for current)
NIFTY_TICK_SIZE=0.05         # Minimum price movement
BANKNIFTY_LOT_SIZE=15        # BankNifty lot size (check NSE for current)
BANKNIFTY_TICK_SIZE=0.05     # Minimum price movement

# Strategy Parameters
# WWT Strategy
WWT_EMA_PERIOD=10
WWT_CI_EMA_PERIOD=21
WWT_WT2_SMA_PERIOD=4

# ORB Strategy
ORB_PERIOD=3                 # Number of candles for opening range
ORB_BREAKOUT_BUFFER=0.001    # 0.1% buffer for breakout confirmation

# Logging
LOG_LEVEL=INFO               # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=zerodha_bot.log
TRADE_JOURNAL_FILE=trade_journal.csv

# WebSocket
WS_RECONNECT_ATTEMPTS=5
WS_RECONNECT_DELAY=5         # seconds between reconnect attempts

# Market Hours (IST - Indian Standard Time)
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=15
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=30
