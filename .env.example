# Binance Trading Bot Configuration
# Copy this file to .env and fill in your values

# API Credentials (REQUIRED)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Risk Management
RISK_PER_TRADE=0.02          # Risk 2% per trade
MAX_POSITION_SIZE=0.5        # Max 50% of balance per trade
STOP_LOSS_PERCENT=0.02       # 2% stop loss
TAKE_PROFIT_PERCENT=0.04     # 4% take profit
MAX_DAILY_LOSS=0.05          # Stop trading if 5% daily loss
MAX_DRAWDOWN=0.10            # Stop trading if 10% drawdown from peak

# Trading Mode
PAPER_TRADING=true           # Set to false for live trading
INITIAL_PAPER_BALANCE=10000  # Starting balance for paper trading

# WWT Strategy Parameters
WWT_EMA_PERIOD=10
WWT_CI_EMA_PERIOD=21
WWT_WT2_SMA_PERIOD=4

# ORB Strategy Parameters
ORB_PERIOD=3                 # Number of candles for opening range
ORB_BREAKOUT_BUFFER=0.001    # 0.1% buffer for breakout confirmation

# Logging
LOG_LEVEL=INFO               # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=trading_bot.log
TRADE_JOURNAL_FILE=trade_journal.csv

# WebSocket
WS_RECONNECT_ATTEMPTS=5
WS_RECONNECT_DELAY=5         # seconds between reconnect attempts
